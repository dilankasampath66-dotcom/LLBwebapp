generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
  SUPER_ADMIN
}

enum TutorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DeleteRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum ContentType {
  CONTENT
  JUDGEMENT
}

model User {
  id              String       @id @default(cuid())
  fullName        String
  email           String       @unique
  phone           String       @unique
  passwordHash    String
  studyYear       Int          // 3, 4, 5, 6
  role            Role         @default(STUDENT)
  tutorStatus     TutorStatus  @default(NONE)
  tutorNote       String?      // Optional note when applying
  emailVerified   Boolean      @default(false)
  isActive        Boolean      @default(true)
  resetToken      String?      @unique
  resetTokenExpiry DateTime?
  verifyToken     String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdContent    Content[]       @relation("ContentCreator")
  reviewedContent   Content[]       @relation("ContentReviewer")
  createdJudgements Judgement[]     @relation("JudgementCreator")
  reviewedJudgements Judgement[]    @relation("JudgementReviewer")
  deleteRequests    DeleteRequest[] @relation("DeleteRequester")
  deleteDecisions   DeleteRequest[] @relation("DeleteDecider")
}

model Subject {
  id       String    @id @default(cuid())
  name     String
  level    Int       // 3, 4, 5, 6
  content  Content[]

  @@unique([name, level])
}

model Content {
  id           String        @id @default(cuid())
  level        Int
  subjectId    String
  subject      Subject       @relation(fields: [subjectId], references: [id])
  sessionName  String
  description  String?       @db.Text
  videoUrl     String?
  documentUrls String[]      // Array of Google Drive links
  documentLabels String[]    // Labels for each document
  status       ContentStatus @default(DRAFT)
  createdById  String
  createdBy    User          @relation("ContentCreator", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?         @relation("ContentReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  deletedAt    DateTime?     // Soft delete
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([level, subjectId, status])
  @@index([createdById])
  @@index([status])
}

model Judgement {
  id           String        @id @default(cuid())
  caseName     String
  caseNo       String
  summary      String        @db.Text
  level        Int?
  subjectId    String?
  videoUrl     String?
  documentUrls String[]
  documentLabels String[]
  status       ContentStatus @default(DRAFT)
  createdById  String
  createdBy    User          @relation("JudgementCreator", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?         @relation("JudgementReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdById])
}

model DeleteRequest {
  id            String             @id @default(cuid())
  contentType   ContentType
  contentId     String
  reason        String?
  requestedById String
  requestedBy   User               @relation("DeleteRequester", fields: [requestedById], references: [id])
  status        DeleteRequestStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?              @relation("DeleteDecider", fields: [decidedById], references: [id])
  decisionNote  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
}

model SiteSettings {
  id                    Int      @id @default(1)
  logoUrl               String?  
  homepageBackgroundUrls String[]
  homepageHeadline      String   @default("OUSL Law Student Portal")
  homepageSubtext       String   @default("Access study materials, lecture videos, and landmark judgements")
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // e.g. 'APPROVE_CONTENT', 'REJECT_TUTOR', 'DELETE_CONTENT'
  targetType String   // e.g. 'Content', 'Judgement', 'User'
  targetId   String
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([targetType, targetId])
}
